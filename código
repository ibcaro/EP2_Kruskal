#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int u, v, custo;
} Aresta;

#define NUM_VERTICES 11
#define NUM_ARESTAS 25

char vertices[] = {'A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K'};

Aresta arestas[NUM_ARESTAS] = {
    {0, 6, 6},
    {0, 4, 3},
    {4, 6, 4},
    {0, 9, 7},
    {9, 3, 4},
    {0, 3, 5},
    {0, 1, 8},
    {1, 9, 5},
    {1, 3, 3},
    {1, 10, 5},
    {1, 2, 6},
    {3, 10, 2},
    {10, 2, 3},
    {3, 2, 7},
    {3, 4, 4},
    {3, 5, 3},
    {4, 5, 5},
    {5, 6, 3},
    {5, 8, 4},
    {5, 7, 6},
    {6, 7, 7},
    {3, 8, 5},
    {8, 7, 2},
    {8, 2, 4},
    {2, 7, 5}
};

int pai[NUM_VERTICES];
int rank_[NUM_VERTICES];

void inicializa(void) {
    for (int i = 0; i < NUM_VERTICES; i++) {
        pai[i] = i;
        rank_[i] = 0;
    }
}

int encontra(int x) {
    if (pai[x] != x)
        pai[x] = encontra(pai[x]);

    return pai[x];
}

int une(int a, int b) {
    int ra = encontra(a);
    int rb = encontra(b);

    if (ra == rb)
        return 0;

    if (rank_[ra] < rank_[rb])
        pai[ra] = rb;

    else if (rank_[ra] > rank_[rb])
        pai[rb] = ra;

    else {
        pai[rb] = ra;
        rank_[ra]++;
    }

    return 1;
}

int compara(const void *a, const void *b) {
    return ((Aresta *)a)->custo - ((Aresta *)b)->custo;
}

int main(void) {
    int total = 0;
    int escolhidas = 0;

    qsort(arestas, NUM_ARESTAS, sizeof(Aresta), compara);

    inicializa();

    printf("Arestas escolhidas (Kruskal):\n");

    for (int i = 0; i < NUM_ARESTAS && escolhidas < NUM_VERTICES - 1; i++) {

        if (une(arestas[i].u, arestas[i].v)) {

            printf("%c - %c (custo %d)\n",
                   vertices[arestas[i].u],
                   vertices[arestas[i].v],
                   arestas[i].custo);

            total += arestas[i].custo;
            escolhidas++;
        }
    }

    if (escolhidas < NUM_VERTICES - 1)
        printf("Grafo desconexo.\n");

    else
        printf("Valor total: %d\n", total);

    return 0;
}
