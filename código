#include <stdio.h>
#include <stdlib.h>

/* Aresta do grafo: dois vertices e o custo */
typedef struct {
    int u, v, custo;
} Aresta;

/* ---------- ENTRADA (hard-wired) ----------
 * TROQUE pelo grafo da proxima pagina do enunciado.
 * Os vertices vao de 0 a NUM_VERTICES-1.
 */
#define NUM_VERTICES 6
#define NUM_ARESTAS  9

Aresta arestas[NUM_ARESTAS] = {
    {0, 1, 4}, {0, 2, 3}, {1, 2, 1},
    {1, 3, 2}, {2, 3, 4}, {3, 4, 2},
    {4, 5, 6}, {3, 5, 7}, {2, 4, 5}
};

/* ---------- Union-Find (deteccao de ciclos) ---------- */
int pai[NUM_VERTICES];
int rank_[NUM_VERTICES];

void inicializa(void) {
    for (int i = 0; i < NUM_VERTICES; i++) {
        pai[i] = i;
        rank_[i] = 0;
    }
}

/* Encontra o representante do conjunto (com compressao de caminho) */
int encontra(int x) {
    if (pai[x] != x)
        pai[x] = encontra(pai[x]);
    return pai[x];
}

/* Une dois conjuntos; retorna 0 se ja estavam no mesmo (formaria ciclo) */
int une(int a, int b) {
    int ra = encontra(a), rb = encontra(b);
    if (ra == rb) return 0;
    if (rank_[ra] < rank_[rb])      pai[ra] = rb;
    else if (rank_[ra] > rank_[rb]) pai[rb] = ra;
    else { pai[rb] = ra; rank_[ra]++; }
    return 1;
}

/* Comparador para ordenar arestas por custo crescente */
int compara(const void *a, const void *b) {
    return ((const Aresta *)a)->custo - ((const Aresta *)b)->custo;
}

int main(void) {
    int total = 0, escolhidas = 0;

    /* 1. Ordena as arestas por custo crescente */
    qsort(arestas, NUM_ARESTAS, sizeof(Aresta), compara);

    inicializa();

    printf("Arestas escolhidas (Kruskal):\n");

    /* 2. Percorre as arestas, da menor para a maior */
    for (int i = 0; i < NUM_ARESTAS && escolhidas < NUM_VERTICES - 1; i++) {
        /* 3. So aceita a aresta se nao formar ciclo */
        if (une(arestas[i].u, arestas[i].v)) {
            printf("  %d - %d (custo %d)\n",
                   arestas[i].u, arestas[i].v, arestas[i].custo);
            total += arestas[i].custo;
            escolhidas++;
        }
    }

    if (escolhidas < NUM_VERTICES - 1)
        printf("Grafo desconexo: nao existe arvore geradora.\n");
    else
        printf("Valor total: %d\n", total);

    return 0;
}
